# Copiá este archivo como Backend/.env para correr la API en local.
# En producción, las mismas variables se cargan en Vercel
# (Project → Settings → Environment Variables).

# Base de datos Turso: `turso db show <db> --url` y `turso db tokens create <db>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Contraseña única para entrar a la app
APP_PASSWORD=

# Secreto para firmar las sesiones (cualquier string largo y aleatorio)
JWT_SECRET=
